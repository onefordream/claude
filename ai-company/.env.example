# ===== AI COMPANY 環境変数 =====
# ブラウザに公開してよいのは NEXT_PUBLIC_ で始まる値だけです。

# --- Supabase（必須） ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。絶対にクライアントへ出さないこと（XP付与・利用量記録・Webhookで使用）
SUPABASE_SERVICE_ROLE_KEY=

# --- AI（必須） ---
AI_PROVIDER=openai
OPENAI_API_KEY=
# 安価な既定モデル。高性能モデルへは環境変数で切替
OPENAI_MODEL=gpt-4.1-mini
# 推定原価計算用（USD / 100万トークン）
AI_PRICE_INPUT_PER_MTOK=0.40
AI_PRICE_OUTPUT_PER_MTOK=1.60
# 全ユーザー合計の1日あたり推定原価上限（USD）。超えるとAI機能を一時停止
AI_GLOBAL_DAILY_BUDGET_USD=20

# --- アプリ ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Tokyo
# 管理者ダッシュボードを使えるメールアドレス（カンマ区切り）
ADMIN_EMAILS=

# --- Stripe（Phase 2・未設定でも無料版は動作します） ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# --- ローカル開発専用モード ---
# 1 にすると Supabase/OpenAI なしで動く「開発モード」（メモリ保存＋モックAI）。
# Vercel 本番（VERCEL_ENV=production）では無効化されます。
DEV_LOCAL_MODE=0
DEV_SESSION_SECRET=change-me-local-only
