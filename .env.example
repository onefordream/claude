# ============================================================
# 店舗ブランディング設定 — 新しい店舗用にセットアップするときは
# このセクションと public/logo.png の差し替えだけでOKです。
# ============================================================
STUDIO_NAME=GOLF STUDIO SHADOW
APP_TAGLINE=ゴルフ成長AI記録ノート
# メインカラー(HEX)。ここを変えるだけでボタン・ナビ・見出し等の色が自動で変わります
BRAND_COLOR=#1b6b4f

# サーバー設定
PORT=3000

# セッション署名用の秘密鍵(本番では必ず長いランダム文字列に変更してください)
SESSION_SECRET=change-me-to-a-long-random-string

# Anthropic API (AI要約・練習提案機能に使用)
# https://console.anthropic.com で発行したAPIキーを設定してください
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# 初回起動時にシードする指導者(オーナー)アカウント
OWNER_NAME=シャドー代表
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-please
