# ---- 必須 ----
# PostgreSQL 接続文字列（Supabase / Neon など）
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
# セッションCookie署名用の秘密鍵（32文字以上のランダム文字列。例: openssl rand -base64 48）
SESSION_SECRET=""
# 公開URL（メール内リンク・Stripe のリダイレクト先に使用）
APP_URL="http://localhost:3000"

# ---- Stripe（4つすべて設定すると実決済モード。1つでも欠けるとモック決済モード）----
STRIPE_SECRET_KEY=""          # sk_test_...
STRIPE_WEBHOOK_SECRET=""      # whsec_...
STRIPE_PRICE_ENTRY_FEE=""     # 入会金 11,000円（税込・一回払い）の Price ID
STRIPE_PRICE_MONTHLY=""       # 月会費 2,178円（税込・月次）の Price ID

# ---- seed 用（npm run db:seed）----
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""        # 12文字以上
# サンプルデータを作らない場合は false
SEED_SAMPLE_DATA="true"
